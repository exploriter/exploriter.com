{
   "name": "exploriter",
   "type": "module",
   "version": "0.0.1",
   "engines": {
      "node": ">=22.12.0"
   },
   "scripts": {
      "dev": "astro dev",
      "build": "astro build",
      "preview": "astro preview",
      "astro": "astro",
      "generate-types": "wrangler types"
   },
   "dependencies": {
      "@astrojs/cloudflare": "^14.3.3",
      "@astrojs/mdx": "^8.0.2",
      "@astrojs/react": "^7.0.0",
      "@base-ui/react": "^1.8.0",
      "@phosphor-icons/react": "^2.1.10",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-table": "9.2.6",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "astro": "^7.3.5",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "react": "^19.3.0",
      "react-dom": "^19.3.0",
      "shadcn": "^4.21.1",
      "tailwind-merge": "^3.7.0",
      "tailwindcss": "^4.3.3",
      "tw-animate-css": "^1.4.0",
      "wrangler": "^4.147.0"
   },
   "devDependencies": {
      "@astrojs/check": "^0.9.10",
      "@astrojs/ts-plugin": "^1.10.12",
      "prettier": "3.9.5",
      "prettier-plugin-astro": "1.1.0",
      "typescript": "^6.0.3"
   },
   "prettier": {
      "plugins": [
         "prettier-plugin-astro"
      ],
      "overrides": [
         {
            "files": "*.astro",
            "options": {
               "parser": "astro"
            }
         }
      ],
      "semi": true,
      "singleQuote": false,
      "tabWidth": 3,
      "trailingComma": "es5",
      "printWidth": 150
   },
   "overrides": {
      "vite": "^7"
   }
}
